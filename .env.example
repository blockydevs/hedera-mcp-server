HEDERA_HTTP_HOST="localhost" # HTTP server bind host (use 0.0.0.0 to expose externally)
HEDERA_HTTP_PORT="3001" # HTTP server listen port
HEDERA_HTTP_ALLOWED_HOSTS="" # Comma-separated hostnames allowed in Host header
ORIGIN_AUTH_VERIFICATION_ENABLED="false" # Enable/disable HMAC origin verification (X-Origin-Signature headers)
ORIGIN_AUTH_SECRET_FILE_PATH="" # Absolute path to file containing the HMAC shared secret

# --- Wallet signing (optional) ------------------------------------------------
# Set BOTH of the next two to enable non-custodial wallet approval. Leave both
# empty to run without wallet signing: RETURN_BYTES, no OAuth, account taken from
# the x-hedera-account-id header. (Setting exactly one fails at startup.)
WALLETCONNECT_PROJECT_ID="" # Project ID from https://cloud.reown.com
PUBLIC_URL="" # Public https origin of this server, e.g. https://mcp.example.com
              # Also the OAuth issuer and the domain bound into the sign-in nonce.

# Postgres for the OAuth/session store. REQUIRED when wallet signing is enabled.
# Local dev: `docker compose up -d` then use the URL below.
DATABASE_URL="postgresql://hedera_mcp:hedera_mcp@localhost:5433/hedera_mcp"
DB_SYNCHRONIZE="false"    # OFF by default (safe); schema owned by migrations. true only for throwaway dev.
DB_MIGRATIONS_RUN="false"  # true = apply pending migrations at startup (single-instance). Else run: npm run migration:run

DAPP_NAME="Hedera MCP Server"                # Shown on the wallet's pairing screen
DAPP_DESCRIPTION=""                          # Shown on the wallet's pairing screen
DAPP_ICON_URL=""                             # Shown on the wallet's pairing screen

# Defaults below match the code and are chosen for security reasons (see src/config.ts). They are
# NOT clamped at runtime — any value you set here is honored, so raising the request/ceremony TTLs
# weakens the properties those short lifetimes provide. (Issued access/refresh token expiries are
# separately bounded by the WalletConnect pairing expiry in provider.ts.)
SIGN_REQUEST_TTL_MS="180000"    # 180 s — matches Hedera's tx-validity window
SIGNIN_NONCE_TTL_MS="300000"    # 5 min  — sign-in challenge lifetime
CEREMONY_TTL_MS="300000"        # 5 min  — browser ceremony (holds the wc: URI; keep ≤5 min)
ACCESS_TOKEN_TTL_MS="3600000"   # 1 hour
REFRESH_TOKEN_TTL_MS="604800000" # 7 days — capped by the WalletConnect session expiry

# --- Resource governance & bind safety ---
MAX_SESSIONS="500"               # cap on concurrent MCP sessions (OOM-flood guard)
RATE_LIMIT_PER_MINUTE="120"      # per-IP request cap on /mcp,/authorize,/register,/token,/connect
MAX_CONCURRENT_APPROVALS="3"     # per-account pending wallet prompts (prompt-spam guard)
TRUST_PROXY_HOPS="1"             # proxy hops to trust for the real client IP (behind TLS proxy)
# ALLOW_INSECURE="true"          # override the fail-closed guard on a non-loopback bind (NOT for prod)

# --- Encryption at rest ---
# Required in wallet mode, min 32 chars (generate: openssl rand -base64 32). The server refuses
# to start without it unless WC_ALLOW_PLAINTEXT=true opts into plaintext storage (dev only).
# WC_ENCRYPTION_KEY="<strong secret>"  # AES-256-GCM the WalletConnect symKeys in wc_kv
# WC_ALLOW_PLAINTEXT="true"            # explicit dev-only opt-out of wc_kv encryption

# --- Logging ---
LOG_LEVEL="info"    # debug|info|warn|error|silent
LOG_PRETTY="false"  # true = human emoji lines for local dev; false = JSON for aggregators
