{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // The base config sets rootDir to src/ for emit; this project only typechecks, and it
    // spans src/ + test/, so the constraint does not apply.
    "rootDir": "."
  },
  "include": ["src/**/*", "test/**/*", "eslint.config.js"],
  "exclude": ["node_modules", "dist"]
}
